{
  "name": "sunnysideup/slideshowblock",
  "description": "Adds an elemental block to your Silverstripe website that looks like a slideshow.",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "slideshow",
    "block",
    "elemental",
    "slides",
    "presentation",
    "deck",
    "simplify",
    "complex info made easy"
  ],
  "license": "BSD-3-Clause",
  "require": {
    "silverstripe/framework": "^5.0",
    "silverstripe/admin": "^2.0",
    "dnadesign/silverstripe-elemental": "^5.0",
    "symbiote/silverstripe-gridfieldextensions": "^4.0"
  },
  "require-dev": {
  },
  "autoload": {
    "psr-4": {
      "Sunnysideup\\SlideShowBlock\\": "src/"
    }
  },
  "extra": {
    "expose": [
      "client/dist"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "bin": [
    "bin/sake-npm-build-slideshowblock.sh",
    "bin/sake-npm-watch-slideshowblock.sh"
  ],
  "authors": [
    {
      "name": "Nicolaas Thiemen Francken",
      "email": "modules@sunnysideup.co.nz",
      "role": "lead developer"
    }
  ]
}
